STUDIO_ADDRESS=127.0.0.1:8080
STUDIO_DATA_DIR=/var/lib/overpass-studio/data
STUDIO_ALLOWED_ORIGINS=https://studio.example.com
STUDIO_AUTH_MODE=trusted-header
STUDIO_AUTH_HEADER=X-Studio-Authenticated-User
STUDIO_AUTH_PROXY_SECRET_HEADER=X-Studio-Proxy-Secret
# Generate at least 32 base64url characters and keep this value identical to
# the rendered Nginx configuration. Never commit the real value.
STUDIO_AUTH_PROXY_SECRET=
