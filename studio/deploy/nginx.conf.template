events {}

http {
    map $http_upgrade $studio_connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream studio_frontend {
        server 127.0.0.1:3000;
        keepalive 16;
    }

    upstream studio_api {
        server 127.0.0.1:8080;
        keepalive 16;
    }

    server {
        listen 443 ssl;
        server_name ${STUDIO_PUBLIC_HOST};

        ssl_certificate     ${STUDIO_TLS_CERTIFICATE};
        ssl_certificate_key ${STUDIO_TLS_CERTIFICATE_KEY};

        # The SSO endpoint must return 2xx and X-Authenticated-User for a valid
        # session, or 401/403 otherwise. This location is unreachable externally.
        location = /_studio_auth {
            internal;
            proxy_pass ${STUDIO_AUTH_REQUEST_URL};
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header Host $host;
        }

        # Liveness/readiness remains public for the local supervisor and load balancer.
        location = /healthz {
            proxy_set_header Host localhost;
            proxy_pass http://studio_api;
        }

        location /api/ {
            auth_request /_studio_auth;
            auth_request_set $studio_authenticated_user $upstream_http_x_authenticated_user;

            # Always replace client-supplied trust headers.
            proxy_set_header X-Studio-Authenticated-User $studio_authenticated_user;
            proxy_set_header X-Studio-Proxy-Secret "${STUDIO_AUTH_PROXY_SECRET}";
            proxy_set_header Host localhost;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_pass http://studio_api;
        }

        location / {
            auth_request /_studio_auth;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $studio_connection_upgrade;
            proxy_pass http://studio_frontend;
        }
    }
}
