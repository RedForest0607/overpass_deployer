      {
        "id": "service-redis-dev",
        "kind": "redis",
        "name": "istock-redis-dev",
        "spec": {
          "location": "hosted",
          "ports": [{ "name": "main", "servicePort": 6379, "protocol": "TCP" }],
          "deployment": {
            "directories": [
              "/app/redis",
              "/app/redis/data",
              "/app/redis/sentinel"
            ],
            "files": [
              {
                "artifactRef": "artifact-replace-redis-conf",
                "remotePath": "/app/redis/redis.conf",
                "chmod": "0644"
              },
              {
                "artifactRef": "artifact-replace-redis-sentinel-conf",
                "remotePath": "/app/redis/sentinel/sentinel.conf",
                "chmod": "0644"
              },
              {
                "artifactRef": "artifact-replace-redis-compose",
                "remotePath": "/app/redis/docker-compose.yml",
                "chmod": "0644"
              }
            ],
            "services": [
              { "name": "istock-redis", "enabled": true, "state": "restarted" }
            ]
          }
        }
      },
      {
        "id": "service-elasticsearch-dev",
        "kind": "elasticsearch",
        "name": "elasticsearch-dev",
        "spec": {
          "location": "hosted",
          "ports": [{ "name": "main", "servicePort": 9200, "protocol": "TCP" }],
          "deployment": {
            "directories": ["/app/elasticsearch"],
            "files": [
              {
                "artifactRef": "artifact-replace-elasticsearch-archive",
                "packagePath": "files/elasticsearch/elasticsearch.tar.gz",
                "remotePath": "/tmp/elasticsearch.tar.gz",
                "extract": {
                  "enabled": true,
                  "remoteDir": "/app/elasticsearch",
                  "stripComponents": 1,
                  "sudo": true,
                  "owner": "elasticsearch",
                  "group": "elasticsearch",
                  "chownRecursive": true
                }
              }
            ],
            "services": []
          }
        }
      },
