{
  "environment": "dev",
  "blueprint": {
    "apiVersion": "studio.deployer/v1",
    "deployment": {
      "ssh": {
        "user": "ec2-user",
        "keyPath": "${ISTOCKMALL_DEV_SSH_KEY_PATH}",
        "knownHostsPath": "${ISTOCKMALL_KNOWN_HOSTS_PATH}",
        "hostKeyChecking": "accept-new",
        "port": 22,
        "timeoutSeconds": 30
      },
      "bastion": {
        "host": "54.116.159.65",
        "user": "ec2-user",
        "keyPath": "${ISTOCKMALL_DEV_SSH_KEY_PATH}",
        "aliasUser": "ec2-user",
        "targetKeyPath": "${ISTOCKMALL_DEV_TARGET_KEY_PATH}"
      },
      "bootstrap": {
        "packages": ["nmap-ncat", "net-tools", "unzip", "wget", "vim-enhanced"],
        "jdk": {
          "enabled": true,
          "vendor": "corretto",
          "major": 25,
          "headless": false
        },
        "osUpdate": { "enabled": true },
        "timezone": "Asia/Seoul",
        "swap": { "enabled": true, "path": "/swapfile", "size": "4G" }
      },
      "directoryDefaults": [
        { "prefix": "/app", "owner": "ec2-user", "group": "ec2-user" }
      ]
    },
    "nodes": [
      {
        "id": "vm-devwas",
        "kind": "vm",
        "name": "devwas",
        "spec": {
          "provider": "aws-ec2",
          "host": "10.20.10.41",
          "deployment": {
            "tags": ["stock-company", "dev", "was", "overpass"],
            "directories": ["/app/overpass"]
          }
        }
      },
      {
        "id": "vm-devapp",
        "kind": "vm",
        "name": "devapp",
        "spec": {
          "provider": "aws-ec2",
          "host": "10.20.10.202",
          "deployment": {
            "tags": ["stock-company", "dev", "app", "search", "agents"],
            "bootstrap": {
              "users": [
                {
                  "name": "elasticsearch",
                  "group": "elasticsearch",
                  "system": true,
                  "createHome": false
                }
              ],
              "dockerCompose": { "enabled": true }
            },
            "directories": ["/app/redis", "/app/elasticsearch"]
          }
        }
      },
      {
        "id": "app-fo-pcweb",
        "kind": "java",
        "name": "fo-pcweb",
        "spec": {
