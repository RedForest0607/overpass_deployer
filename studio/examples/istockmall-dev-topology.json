          "javaVersion": "25",
          "maxHeap": "1g",
          "ports": [
            { "name": "main", "servicePort": 25202, "protocol": "TCP" }
          ],
          "deployment": {
            "tags": ["fo", "pcweb"],
            "baseDir": "/app/overpass/fo-pcweb",
            "minHeap": "256m",
            "configFiles": [
              {
                "artifactRef": "artifact-replace-fo-pcweb-application",
                "remotePath": "/app/overpass/fo-pcweb/config/application.yml"
              },
              {
                "artifactRef": "artifact-replace-fo-pcweb-logback",
                "remotePath": "/app/overpass/fo-pcweb/config/logback-spring.xml"
              },
              {
                "artifactRef": "artifact-replace-fo-pcweb-env",
                "remotePath": "/app/overpass/fo-pcweb/config/fo-pcweb.env"
              }
            ],
            "script": {
              "mode": "template",
              "template": "embedded:server.sh.tmpl",
              "valuesArtifactRef": "artifact-replace-fo-pcweb-values",
              "remotePath": "/app/overpass/fo-pcweb/bin/server.sh"
            }
          }
        }
      },
