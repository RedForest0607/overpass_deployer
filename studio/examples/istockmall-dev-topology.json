        "id": "database-postgresql-dev",
        "kind": "database",
        "name": "istockdev-postgresql",
        "spec": {
          "engine": "postgresql",
          "endpoint": "10.20.30.87",
          "ports": [{ "name": "main", "servicePort": 5432, "protocol": "TCP" }],
          "secretRef": "secret-replace-istockdev-postgresql"
