{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.overpass.dev/schemas/blueprint-v1.schema.json",
  "title": "Overpass Studio Blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "nodes", "placements", "connections"],
  "properties": {
    "apiVersion": { "const": "studio.deployer/v1" },
    "deployment": { "$ref": "#/$defs/deploymentProfile" },
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    },
    "placements": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/placement" }
    },
    "connections": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "maxLength": 128 },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "servicePort", "protocol"],
      "properties": {
        "name": { "type": "string", "maxLength": 63 },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["TCP", "UDP"] }
      }
    },
    "deploymentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh"],
      "properties": {
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "keyPath", "knownHostsPath", "hostKeyChecking"],
          "properties": {
            "user": { "type": "string" },
            "keyPath": { "type": "string" },
            "knownHostsPath": { "type": "string" },
            "hostKeyChecking": { "enum": ["strict", "accept-new", "insecure"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "timeoutSeconds": { "type": "integer", "minimum": 0 }
          }
        },
        "bastion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": { "type": "string" },
            "user": { "type": "string" },
            "keyPath": { "type": "string" },
            "knownHostsPath": { "type": "string" },
            "hostKeyChecking": { "enum": ["strict", "accept-new", "insecure"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "timeoutSeconds": { "type": "integer", "minimum": 0 },
            "aliasUser": { "type": "string" },
            "sshConfigPath": { "type": "string" },
            "shellAliasesPath": { "type": "string" },
            "targetKnownHostsPath": { "type": "string" },
            "targetKeyPath": { "type": "string" }
          }
        },
        "bootstrap": { "$ref": "#/$defs/bootstrapProfile" },
        "directoryDefaults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prefix", "owner"],
            "properties": {
              "prefix": { "type": "string" },
              "owner": { "type": "string" },
              "group": { "type": "string" }
            }
          }
        }
      }
    },
    "serviceSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "state": { "enum": ["started", "stopped", "restarted"] }
      }
    },
    "extractProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "remoteDir": { "type": "string" },
        "stripComponents": { "type": "integer", "minimum": 0 },
        "stagingPath": { "type": "string" },
        "sudo": { "type": "boolean" },
        "owner": { "type": "string" },
        "group": { "type": "string" },
        "chownRecursive": { "type": "boolean" },
        "keepStagedArchive": { "type": "boolean" }
      }
    },
    "artifactDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "remotePath"],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/id" },
        "packagePath": { "type": "string" },
        "remotePath": { "type": "string" },
        "chmod": { "type": "string", "pattern": "^0?[0-7]{3}$" },
        "extract": { "$ref": "#/$defs/extractProfile" }
      }
    },
    "configArtifactDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "remotePath"],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/id" },
        "packagePath": { "type": "string" },
        "remotePath": { "type": "string" }
      }
    },
    "bootstrapProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": { "type": "array", "items": { "type": "string" } },
        "users": { "type": "array", "items": { "type": "object" } },
        "sysctls": { "type": "array", "items": { "type": "object" } },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/serviceSetting" }
        },
        "jdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "vendor": { "type": "string" },
            "major": { "type": "integer" },
            "headless": { "type": "boolean" }
          }
        },
        "osUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "timezone": { "type": "string" },
        "swap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "size": { "type": "string" }
          }
        },
        "dockerCompose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "version": { "type": "string" },
            "sourceUrl": { "type": "string" },
            "installPath": { "type": "string" }
          }
        }
      }
    },
    "utilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "directories": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactDelivery" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/serviceSetting" }
        }
      }
    },
    "utilityDeployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactDelivery" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/serviceSetting" }
        }
      }
    },
    "vmDeployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bastionHost": { "type": "string" },
        "bastionSSHPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bootstrap": { "$ref": "#/$defs/bootstrapProfile" },
        "directories": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactDelivery" }
        },
        "utilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/utilityProfile" }
        }
      }
    },
    "scriptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "remotePath"],
      "properties": {
        "mode": { "enum": ["template", "local-file"] },
        "template": { "type": "string" },
        "artifactRef": { "$ref": "#/$defs/id" },
        "packagePath": { "type": "string" },
        "valuesArtifactRef": { "$ref": "#/$defs/id" },
        "valuesPackagePath": { "type": "string" },
        "remotePath": { "type": "string" },
        "remoteDir": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "local-file" } } },
          "then": {
            "required": ["artifactRef"],
            "not": {
              "anyOf": [
                { "required": ["template"] },
                { "required": ["valuesArtifactRef"] }
              ]
            }
          }
        }
      ]
    },
    "javaDeployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "baseDir": { "type": "string" },
        "jarRemotePath": { "type": "string" },
        "jarPackagePath": { "type": "string" },
        "minHeap": { "type": "string" },
        "javaOptions": { "type": "array", "items": { "type": "string" } },
        "extraOptions": { "type": "array", "items": { "type": "string" } },
        "configFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/configArtifactDelivery" }
        },
        "extraFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactDelivery" }
        },
        "script": { "$ref": "#/$defs/scriptProfile" }
      }
    },
    "vmSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host"],
      "properties": {
        "provider": { "enum": ["on-prem", "aws-ec2"] },
        "host": { "type": "string", "maxLength": 253 },
        "deployment": { "$ref": "#/$defs/vmDeployment" }
      }
    },
    "javaSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "javaVersion", "maxHeap", "ports"],
      "properties": {
        "artifactRef": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "javaVersion": { "type": "string", "maxLength": 32 },
        "maxHeap": { "type": "string", "maxLength": 32 },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "deployment": { "$ref": "#/$defs/javaDeployment" }
      }
    },
    "hostedServiceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "ports"],
      "properties": {
        "location": { "enum": ["hosted", "external"] },
        "endpoint": { "type": "string", "maxLength": 2048 },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "secretRef": { "type": "string", "maxLength": 128 },
        "deployment": { "$ref": "#/$defs/utilityDeployment" }
      }
    },
    "databaseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "endpoint", "ports"],
      "properties": {
        "engine": { "const": "postgresql" },
        "endpoint": { "type": "string", "maxLength": 2048 },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "secretRef": { "type": "string", "maxLength": 128 }
      }
    },
    "kubernetesSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": { "namespace": { "type": "string", "maxLength": 253 } }
    },
    "registrySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string", "maxLength": 2048 },
        "secretRef": { "type": "string", "maxLength": 128 }
      }
    },
    "ingressSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": { "host": { "type": "string", "maxLength": 253 } }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/vmNode" },
        { "$ref": "#/$defs/javaNode" },
        { "$ref": "#/$defs/redisNode" },
        { "$ref": "#/$defs/elasticsearchNode" },
        { "$ref": "#/$defs/databaseNode" },
        { "$ref": "#/$defs/kubernetesNode" },
        { "$ref": "#/$defs/registryNode" },
        { "$ref": "#/$defs/ingressNode" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "kind", "name", "spec"]
    },
    "vmNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "vm" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/vmSpec" }
          }
        }
      ]
    },
    "javaNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "java" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/javaSpec" }
          }
        }
      ]
    },
    "redisNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "redis" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/hostedServiceSpec" }
          }
        }
      ]
    },
    "elasticsearchNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "elasticsearch" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/hostedServiceSpec" }
          }
        }
      ]
    },
    "databaseNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "database" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/databaseSpec" }
          }
        }
      ]
    },
    "kubernetesNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "kubernetes" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/kubernetesSpec" }
          }
        }
      ]
    },
    "registryNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "registry" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/registrySpec" }
          }
        }
      ]
    },
    "ingressNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "ingress" },
            "name": { "$ref": "#/$defs/name" },
            "spec": { "$ref": "#/$defs/ingressSpec" }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloadRef", "targetRef", "mode"],
      "properties": {
        "workloadRef": { "$ref": "#/$defs/id" },
        "targetRef": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["process", "compose", "kubernetes"] }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceRef", "targetRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["connects_to", "routes_to", "publishes_to"] },
        "sourceRef": { "$ref": "#/$defs/id" },
        "targetRef": { "$ref": "#/$defs/id" },
        "targetPortName": { "type": "string", "maxLength": 63 }
      }
    }
  }
}
